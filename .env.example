# PostgreSQL connection string — Render gives you this automatically when
# you attach a free Postgres instance to this service. Format:
# postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="postgresql://user:password@localhost:5432/botxchange"

# Secret used to sign login JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# 32-byte (64 hex character) key used to encrypt Delta Exchange API keys/secrets
# at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-with-a-64-char-hex-string"

# Comma-separated list of frontend origins allowed to call this API
# (your Google AI Studio app's published URL, plus localhost for local dev).
CORS_ORIGINS="http://localhost:3000,https://your-ai-studio-app-url.web.app"

# Delta Exchange India REST API base URL — usually never needs to change.
DELTA_API_BASE_URL="https://api.india.delta.exchange"

# Delta Exchange India TESTNET base URL — used for "demo" accounts. Users
# generate a separate key/secret for this at https://testnet.delta.exchange
DELTA_TESTNET_BASE_URL="https://cdn-ind.testnet.deltaex.org"

# NOTE: the frontend's dev server is hard-coded to port 3000
# (see frontend/package.json's "dev" script) — this is deliberately a
# different port so running both locally at once doesn't collide.
PORT=4000
NODE_ENV=production
